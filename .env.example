# Демонстрационный режим не требует ключей и не вызывает модель.
# Боевой вызов включается только если заданы все три переменные
# и имя модели есть в списке, разрешенном организаторами.

APP_ENV=demo
LOG_LEVEL=INFO

# Адрес, ключ и имя модели организаторы должны выдать отдельно.
# URL здесь намеренно пустой: выдуманный адрес не используется.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Верхняя граница вызовов за процесс, чтобы не расходовать лимит 500 рублей.
LLM_MAX_CALLS=8

# Необязательная живая лента. Несколько адресов через запятую.
# Без этой переменной используется только демонстрационный набор.
NEWS_FEED_URLS=

DATABASE_PATH=
